# ============================================
# AI OPERATIONS PLATFORM - CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================

# --- CORE ---
PLATFORM_NAME=my-ai-platform
DOMAIN=ai.yourdomain.com
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=changeme-use-strong-password
SECRET_KEY=generate-with-openssl-rand-hex-32

# --- AI PROVIDERS ---
ANTHROPIC_API_KEY=sk-ant-...
# Bruges kun til embeddings (vector search i memory-tabellen) — valgfri.
OPENAI_API_KEY=sk-...

# --- DEFAULT MODEL ---
DEFAULT_MODEL=claude-sonnet-4-20250514
FAST_MODEL=claude-haiku-4-5-20251001

# --- DATABASE ---
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=aiplatform
DATABASE_URL=postgresql+asyncpg://aiplatform:change-this-password@postgres:5432/aiplatform

# --- REDIS ---
REDIS_URL=redis://redis:6379/0

# --- EMAIL (Gmail OAuth or SMTP) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Or use SMTP:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- CALENDAR (Google Calendar) ---
GOOGLE_CALENDAR_CREDENTIALS=  # Base64 encoded service account JSON

# --- SLACK ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_DEFAULT=general

# --- STRIPE ---
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- GITHUB ---
GITHUB_TOKEN=ghp_...
GITHUB_ORG=
GITHUB_WEBHOOK_SECRET=

# --- CRM (HubSpot) ---
HUBSPOT_API_KEY=
HUBSPOT_PORTAL_ID=

# --- ADVERTISING ---
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# --- VOICE (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- S3 / OBJECT STORAGE ---
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ai-platform-files
S3_REGION=eu-west-1

# --- AGENT SETTINGS ---
EMAIL_CHECK_INTERVAL=60
EMAIL_AUTO_REPLY=false
EMAIL_AUTO_REPLY_CONFIDENCE=0.9
FINANCE_RECONCILIATION_SCHEDULE=0 6 * * *
MARKETING_REPORT_SCHEDULE=0 8 * * 1
SUPPORT_AUTO_RESOLVE_L1=true
SUPPORT_ESCALATION_CHANNEL=support-escalation

# --- MONITORING ---
ENABLE_PROMETHEUS=true
LOG_LEVEL=INFO
